{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    // "DOM" is added solely for fetch/Response/ReadableStream/TextDecoder/
    // AbortSignal *type* declarations used by api/coach.ts's SSE streaming
    // helpers — this package still ships zero DOM-dependent runtime code.
    // Web supplies its native `fetch`; React Native supplies `expo/fetch`'s
    // fetch (structurally compatible, cast at that call site since RN's lib
    // set doesn't include "DOM"). No other module in this package touches a
    // DOM global.
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "declaration": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"]
}
