# Local overrides for Expo config (see app.config.js), auto-loaded by the
# Expo CLI itself when running `expo start` / `expo prebuild` / `expo run:*`
# locally. Copy to `.env` (gitignored, never commit real values there).
#
# This file is NOT read by cloud `eas build` — EAS Build only sees `.env`
# for `eas build --local`. For a real preview/production build, set the same
# var(s) as EAS project environment variables (`eas env:create`) or in the
# relevant profile's `env` block in eas.json instead; eas.json is plain JSON
# and can't carry explanatory comments, which is why this file exists.

# Base URL of the running jiffy-messaging instance that goal-slot-api is
# configured to proxy to (goal-slot-api's own JIFFY_MESSAGING_URL — see its
# .env.example), or jiffy-messaging's directly exposed URL if this build
# talks to it without a proxy. No trailing slash, e.g. https://messages.example.com
#
# Left unset in every environment right now — jiffy-messaging isn't deployed
# yet. That's a deliberate, handled state, not a bug: app.config.js and
# src/lib/messaging-config.ts treat an absent URL as "feature not available
# in this build", so the Messages drawer entry, its search result, and every
# Message button disappear instead of the app crashing or showing a dead
# screen. Setting this is what makes them appear again.
EXPO_PUBLIC_MESSAGING_URL=

# Optional. Only needed if the WebSocket endpoint lives at a different
# host/port than EXPO_PUBLIC_MESSAGING_URL above. jiffy-messaging serves
# REST and WebSocket on the same port, so leave this unset in the normal
# case — app.config.js derives wss://<same host> (or ws:// for http://)
# from EXPO_PUBLIC_MESSAGING_URL automatically.
EXPO_PUBLIC_MESSAGING_WS_URL=
